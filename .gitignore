# env files — keep the example committed
.env
.env.*
!.env.example

# vercel
.vercel
# `.vercel/` has always been ignored. `.vercel-disabled/` is a byte-identical
# copy of the same project identity - it carries the same live `projectId` and
# `orgId` - and it was never covered by the rule above, so renaming the folder
# left the deployment identity in the repository while the ignore stopped
# matching it. Ignoring both is what the original rule already intended.
.vercel-disabled/

# runtime junction/symlink to catalogue image store — do not duplicate ~3.4 GB
/public/catalogue-images

# local catalogue rasters — served via public/catalogue-images junction, never git
/data/source-catalogue/images/
/data/catalogue-image-store/
/data/pensol-catalogue/images/

