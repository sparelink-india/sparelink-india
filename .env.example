# Copy to .env.local for Next.js, or .env for Drizzle CLI.
# Never commit real secrets.

# Public site URL (no trailing slash).
# Local: http://localhost:3000
# Production host: https origin only, required for Cashfree return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Buyer OTP delivery. Production host MUST set a webhook (SMS/WhatsApp gateway).
# Local TEST may omit this; OTP is printed to the server console only in non-production.
# POST JSON { "phoneNumber": "+91XXXXXXXXXX", "code": "123456" }
# Optional: Authorization: Bearer <OTP_DELIVERY_WEBHOOK_TOKEN>
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_WEBHOOK_TOKEN=

# PostgreSQL connection string.
# Optional for `npm run dev` / `npm run build` — the UI does not connect on startup.
# Required for `npm run db:migrate` and `npm run db:studio`.
# Example local URL (change user/password/db name to match your Postgres):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sparelink

TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=

# Cashfree PG (three independent merchant accounts; no Easy Split).
# Ambaji (AMB) is sufficient for the app to run. HIN/IND may stay empty
# until those firms are onboarded. Missing HIN/IND keys must not fall back
# to Ambaji. Never commit real client IDs or secrets. For local TEST+sandbox,
# prefer .env.development.local so production .env.local DATABASE_URL is not overwritten.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_AMB_CLIENT_ID=
CASHFREE_AMB_CLIENT_SECRET=
CASHFREE_HIN_CLIENT_ID=
CASHFREE_HIN_CLIENT_SECRET=
CASHFREE_IND_CLIENT_ID=
CASHFREE_IND_CLIENT_SECRET=

# Razorpay Standard Checkout. Use test keys first; never commit real keys.

