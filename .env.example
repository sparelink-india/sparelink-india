# Copy to .env.local for Next.js, or .env for Drizzle CLI.
# Never commit real secrets.

# Public site URL (no trailing slash).
# Local: http://localhost:3000
# Production host: https origin only, required for Cashfree return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Buyer OTP delivery. Production host MUST set a webhook (SMS/WhatsApp gateway).
# Local TEST may omit this; OTP is printed to the server console only in non-production.
# POST JSON { "phoneNumber": "+91XXXXXXXXXX", "code": "123456" }
# Optional: Authorization: Bearer <OTP_DELIVERY_WEBHOOK_TOKEN>
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_WEBHOOK_TOKEN=

# Temporary: username/password login does not require OTP unless this is true.
OTP_REQUIRED=false

# Google/Gmail login. Leave empty until OAuth credentials are issued.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public WhatsApp business number (digits with country code, no +).
# Storefront falls back to the published Sparelink contact number if empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MAIN=
# Optional per-firm WhatsApp direct chat overrides (digits with country code, no +):
# NEXT_PUBLIC_WHATSAPP_AMBAJI=
# NEXT_PUBLIC_WHATSAPP_HIND=
# NEXT_PUBLIC_WHATSAPP_INDIA_SALES=
NEXT_PUBLIC_SUPPORT_PHONE=+91-7566666536
NEXT_PUBLIC_SUPPORT_EMAIL=SPARELINK.IND@GMAIL.COM

# Support request email (server-side only). Do not put passwords in NEXT_PUBLIC_*.
# Destination defaults to SPARELINK.IN@GMAIL.COM when SUPPORT_EMAIL_TO is empty.
# Typical Gmail STARTTLS port is 587. Do not put real passwords here.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_EMAIL_TO=SPARELINK.IN@GMAIL.COM

# Better Auth (server only). Generate a long random secret on the host.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# PostgreSQL connection string.
# Optional for `npm run dev` / `npm run build` — the UI does not connect on startup.
# Required for `npm run db:migrate` and `npm run db:studio`.
# Example local URL (change user/password/db name to match your Postgres):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sparelink

TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=

# Optional CI / OnlineAutoHandles sync. Leave empty for dry-run/admin-only use.
# Never commit real credentials. Prefer host env / secret store.
# If the public B2B API needs an Authorization header, set it here (e.g. "Bearer …").
CI_SOURCE_AUTH_HEADER=

# Vercel Cron secret for GET /api/cron/ci-sync (Authorization: Bearer <secret>).
# When unset, the cron route refuses to run.
CRON_SECRET=

# Catalogue raster CDN origin (no trailing slash). Path remains /catalogue-images/{key}{ext}.
# Production: https://assets.sparelinkindia.com
# Local development: leave empty to use the public/catalogue-images junction.
CATALOGUE_IMAGE_ORIGIN=

# Cashfree PG (three independent merchant accounts; no Easy Split).
# Ambaji (AMB) is sufficient for the app to run. HIN/IND may stay empty
# until those firms are onboarded. Missing HIN/IND keys must not fall back
# to Ambaji. Never commit real client IDs or secrets. For local TEST+sandbox,
# prefer .env.development.local so production .env.local DATABASE_URL is not overwritten.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_AMB_CLIENT_ID=
CASHFREE_AMB_CLIENT_SECRET=
CASHFREE_HIN_CLIENT_ID=
CASHFREE_HIN_CLIENT_SECRET=
CASHFREE_IND_CLIENT_ID=
CASHFREE_IND_CLIENT_SECRET=

# Razorpay remains disabled in application code. Do not set Razorpay keys.

# Per-firm Bank Transfer / NEFT / RTGS / UPI details & COD toggles (optional).
# When configured, checkout & allocation payment screens display these direct payment options.
# AMBAJI_TRADERS_BANK_ACCOUNT_NAME=
# AMBAJI_TRADERS_BANK_ACCOUNT_NUMBER=
# AMBAJI_TRADERS_BANK_IFSC_CODE=
# AMBAJI_TRADERS_BANK_NAME=
# AMBAJI_TRADERS_BANK_BRANCH=
# AMBAJI_TRADERS_BANK_UPI_ID=
# AMBAJI_TRADERS_BANK_QR_IMAGE_URL=
# AMBAJI_TRADERS_BANK_PAYMENT_INSTRUCTIONS=
# AMBAJI_TRADERS_COD_ENABLED=true

# HIND_MOTORS_BANK_ACCOUNT_NAME=
# HIND_MOTORS_BANK_ACCOUNT_NUMBER=
# HIND_MOTORS_BANK_IFSC_CODE=
# HIND_MOTORS_BANK_NAME=
# HIND_MOTORS_BANK_BRANCH=
# HIND_MOTORS_BANK_UPI_ID=
# HIND_MOTORS_BANK_QR_IMAGE_URL=
# HIND_MOTORS_BANK_PAYMENT_INSTRUCTIONS=
# HIND_MOTORS_COD_ENABLED=true

# INDIA_SALES_BANK_ACCOUNT_NAME=
# INDIA_SALES_BANK_ACCOUNT_NUMBER=
# INDIA_SALES_BANK_IFSC_CODE=
# INDIA_SALES_BANK_NAME=
# INDIA_SALES_BANK_BRANCH=
# INDIA_SALES_BANK_UPI_ID=
# INDIA_SALES_BANK_QR_IMAGE_URL=
# INDIA_SALES_BANK_PAYMENT_INSTRUCTIONS=
# INDIA_SALES_COD_ENABLED=true

# Optional firm seller identity for tax invoices (DB firm.* columns take precedence).
# Leave empty rather than inventing GSTINs. Format: 15-char GSTIN.
# AMBAJI_TRADERS_GSTIN=
# AMBAJI_TRADERS_LEGAL_NAME=
# AMBAJI_TRADERS_ADDRESS=
# AMBAJI_TRADERS_PHONE=
# AMBAJI_TRADERS_EMAIL=
# HIND_MOTORS_GSTIN=
# HIND_MOTORS_LEGAL_NAME=
# HIND_MOTORS_ADDRESS=
# HIND_MOTORS_PHONE=
# HIND_MOTORS_EMAIL=
# INDIA_SALES_GSTIN=
# INDIA_SALES_LEGAL_NAME=
# INDIA_SALES_ADDRESS=
# INDIA_SALES_PHONE=
# INDIA_SALES_EMAIL=

