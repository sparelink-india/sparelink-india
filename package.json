{
  "name": "sparelink-india",
  "version": "0.1.0",
  "private": true,
  "description": "SpareLink India — spare-parts marketplace",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/with-db-target.mjs",
    "db:migrate:test": "node scripts/with-db-target.mjs test migrate",
    "db:migrate:production": "node scripts/with-db-target.mjs production migrate --i-understand-production",
    "db:studio": "node scripts/with-db-target.mjs test studio",
    "db:studio:production": "node scripts/with-db-target.mjs production studio --i-understand-production"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@types/pdfkit": "^0.17.6",
    "better-auth": "^1.7.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typesense": "^3.0.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
